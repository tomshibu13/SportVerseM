# ── SportVerse Backend Environment Variables ──────────────────────────────────
# Rename this file to .env and fill in your real values.
# Never commit the actual .env file to git.

# ── Server ────────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── MongoDB ───────────────────────────────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/sportverse

# ── JWT Auth ──────────────────────────────────────────────────────────────────
JWT_SECRET=your_strong_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# ── Admin Seed Credentials ────────────────────────────────────────────────────
ADMIN_EMAIL=admin@sportverse.com
ADMIN_PASSWORD=Admin@123

# ── Email Service (Gmail SMTP) ────────────────────────────────────────────────
# Use a Gmail App Password (not your real password):
# Google Account → Security → 2-Step Verification → App Passwords
EMAIL_SERVICE=gmail
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password_here

# ── Firebase Admin SDK ────────────────────────────────────────────────────────
# Option A: Paste the full service account JSON as a single line (recommended for deployment)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"sportverse-ai",...}

# Option B: Individual fields (escape private key newlines as \n)
FIREBASE_PROJECT_ID=sportverse-ai
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@sportverse-ai.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----\n"

# ── Portal URLs ───────────────────────────────────────────────────────────────
ADMIN_PORTAL_URL=http://localhost:5173
STATION_OWNER_PORTAL_URL=http://localhost:5174

# ── Google OAuth 2.0 (Flutter → Node.js token verification) ──────────────────
# The Web Client ID — same one used in Flutter and web/index.html
GOOGLE_CLIENT_ID=476540604651-g3n2051unc5cq4ols1d8dcp1gn45082c.apps.googleusercontent.com
