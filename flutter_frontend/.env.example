# ── SportVerse Flutter Environment Variables ─────────────────────────────────
# Rename this file to .env and fill in your real values.
# Loaded at app startup via flutter_dotenv (pubspec.yaml assets: [.env])

# ── Backend API URLs ──────────────────────────────────────────────────────────
# Android device/emulator must use your machine's LAN IP, not localhost
ANDROID_API_URL=http://10.244.238.104:5000/api
API_URL=http://localhost:5000/api

# ── Google OAuth 2.0 ──────────────────────────────────────────────────────────
# Web Client ID from Google Cloud Console → APIs & Services → Credentials
# Used as serverClientId in GoogleSignIn.initialize() and in web/index.html
GOOGLE_SERVER_CLIENT_ID=476540604651-g3n2051unc5cq4ols1d8dcp1gn45082c.apps.googleusercontent.com
